. /*Figure 5.2*/
. twoway bar vens year if year>1959,  bc(gs5)  ///
> || rbar vens scount year if year>1959 , bc(gs10) /// 
> || bar vensforecast_r year if vensforecast_r!=. ,  lc(gs2) lp(shortdash) lw(medium) fcolor(white%0) ///
