{com}. do "$dofiles\02-tab5.5.do"
{txt}
{com}. /* This file provides the code for tabulating construction costs for current host venues
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\):
> venuesdb_mls.dta
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\):
> Tables (Stata viewer): 5.5
> Data (outdat\): ven_cost_current.dta
> Other: 
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. use "$data\venuesdb_mls.dta", clear
{txt}
{com}. 
. g main_mlb =0
{txt}
{com}. replace main_mlb=1 if current_mlb==1
{txt}(30 real changes made)

{com}. g main_nfl =0
{txt}
{com}. replace main_nfl=1 if current_nfl==1
{txt}(30 real changes made)

{com}. 
. g main_lg =league if current==1
{txt}(123 missing values generated)

{com}. replace main_lg ="MLB" if main_mlb==1
{txt}(2 real changes made)

{com}. replace main_lg="NFL" if main_nfl==1
{txt}(6 real changes made)

{com}. replace main_lg="NBA" if current_nba==1 & current_nhl!=1
{txt}(3 real changes made)

{com}. replace main_lg="NHL" if current_nhl==1 & current_nba!=1
{txt}(1 real change made)

{com}. replace main_lg="NBA/NHL" if current_nba==1 & current_nhl==1
{txt}(0 real changes made)

{com}. replace main_lg ="MLS" if current_mls==1 & league!="MLB/MLS" & league!="NFL/MLS"
{txt}(2 real changes made)

{com}. 
. keep if current
{txt}(123 observations deleted)

{com}. drop if team_current=="Seattle Kraken" /*Unique construction/reconstruction history, not included in aggregate costs*/
{txt}(1 observation deleted)

{com}. 
. collapse (count) year (sum) publiccost2024 totalcost2024, by(main_lg)
{res}{txt}
{com}. 
. g pubpct100= (publiccost2024/totalcost2024)*100
{txt}
{com}. format pubpct100 %9.0fc
{txt}
{com}. rename year venues
{res}{txt}
{com}. 
. /*Table 5.5*/
. tabstat venues publiccost2024 totalcost2024 pubpct100, by(main_lg) stats(sum) format(%9.0fc)

{txt}Summary statistics: Sum
Group variable: main_lg 

{ralign 7:main_lg} {...}
{c |}{...}
    venues  pub~2024  tot~2024  pubp~100
{hline 8}{c +}{hline 40}
{ralign 7:MLB} {...}
{c |}{...}
 {res}       29    10,349    18,083        57
{txt}{ralign 7:MLS} {...}
{c |}{...}
 {res}       23     2,476     5,944        42
{txt}{ralign 7:NBA} {...}
{c |}{...}
 {res}       19     4,405    10,767        41
{txt}{ralign 7:NBA/NHL} {...}
{c |}{...}
 {res}       11       636     6,028        11
{txt}{ralign 7:NFL} {...}
{c |}{...}
 {res}       30    11,311    29,863        38
{txt}{ralign 7:NHL} {...}
{c |}{...}
 {res}       20     3,363     7,683        44
{txt}{hline 8}{c +}{hline 40}
{ralign 7:Total} {...}
{c |}{...}
 {res}      132    32,540    78,369       232
{txt}{hline 8}{c BT}{hline 40}

{com}. /* 
> Summary statistics: Sum
> Group variable: main_lg 
> 
> main_lg |    venues  pub~2024  tot~2024  pubp~100
> --------+----------------------------------------
>     MLB |        29    10,349    18,083        57
>     MLS |        23     2,476     5,944        42
>     NBA |        19     4,405    10,767        41
> NBA/NHL |        11       636     6,028        11
>     NFL |        30    11,311    29,863        38
>     NHL |        20     3,363     7,683        44
> --------+----------------------------------------
>   Total |       132    32,540    78,369       232 <== ignore Total pubpct100 (see below)
> -------------------------------------------------
> */
. 
. /*Calcuate overall public share*/
. egen sumpubliccost2024 = sum(publiccost2024)
{txt}
{com}. egen sumtotalcost2024 = sum(totalcost2024)
{txt}
{com}. g sumpubpct100 = (sumpubliccost2024/sumtotalcost2024)*100
{txt}
{com}. format sumpubliccost2024 sumtotalcost2024 sumpubpct100 %9.0fc
{txt}
{com}. 
. sum sumpubpct100, format

{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
sumpubpct100 {c |}{res}          6          42           0         42         42
{txt}
{com}. /*
>     Variable |        Obs        Mean    Std. dev.       Min        Max
> -------------+---------------------------------------------------------
> sumpubpct100 |          6          42           0         42         42
> */
. 
