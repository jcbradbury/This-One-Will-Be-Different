{txt}(1 real change made)

{com}. 
. g lifespan2025= lastyear-year+1
{txt}(32 missing values generated)

{com}. replace lifespan2025 = 2026-year if lifespan2025==.
{txt}(32 real changes made)

{com}. replace lifespan2025 = 2026-year if lastyear>2025 &lastyear!=. /*Keeps age for future closures in 2025 terms*/
{txt}(0 real changes made)

{com}. replace lifespan2025 = . if lifespan2025<1
{txt}(3 real changes made, 3 to missing)

{com}. 
. g renovationspan_2025 = 2025-lastrenovation+1
{txt}(29 missing values generated)

{com}. 
. save "$outdat\mls_lifespans.dta", replace
{txt}{p 0 4 2}
file {bf}
