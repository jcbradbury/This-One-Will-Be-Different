{txt}
{com}. /* This file provides the code for constructing the table of venue construction cost in the appendix.
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> venuesdb_mls.dta
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\):
> Tables (Stata viewer): Table A.1
> Data (outdat\):
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. 
. use "$data\venuesdb_all.dta", clear
{txt}
{com}. 
. g yearst = string(year,"%9.0f")
{txt}
{com}. replace yearst = "TBD" if year==.
{txt}(0 real changes made)

{com}. 
. g tc2024st= string(totalcost2024,"%9.0fc")
{txt}
{com}. replace tc2024st= string(totalcost2024,"%9.2fc") if totalcost2024<1 & totalcost2024>0
{txt}(0 real changes made)

{com}. 
. g tcst= string(totalcost,"%9.0fc")
{txt}
{com}. replace tcst= string(totalcost,"%9.2fc") if totalcost<1 & totalcost>0
{txt}(13 real changes made)

{com}. 
. g pc2024st= string(publiccost2024,"%9.0fc")
{txt}
{com}. replace pc2024st= string(publiccost2024,"%9.2fc") if publiccost2024<1 & publiccost2024>0 
{txt}(0 real changes made)

{com}. 
. g pcst= string(publiccost,"%9.0fc")
{txt}
{com}. replace pcst= string(publiccost,"%9.2fc") if publiccost<1 & publiccost>0
{txt}(2 real changes made)

{com}. 
. g tc2024dol = "\\$" +tc2024st
{txt}
{com}. g pc2024dol = "\\$" +pc2024st
{txt}
{com}. g tcdol = "\\$" +tcst
{txt}
{com}. g pcdol = "\\$" +pcst
{txt}
{com}. g pubpct100st = string(pubpct100,"%9.0f")
{txt}
{com}. g pubpct100stpct = pubpct100st+"\%"
{txt}
{com}. replace tcdol="" if totalcost ==.
{txt}(24 real changes made)

{com}. replace pcdol ="" if publiccost ==.
{txt}(25 real changes made)

{com}. replace tc2024dol ="" if totalcost2024 ==.
{txt}(24 real changes made)

{com}. replace pc2024dol ="" if publiccost2024 ==.
{txt}(25 real changes made)

{com}. replace pubpct100stpct ="" if pubpct100 ==.
{txt}(25 real changes made)

{com}. 
. g venuename_tex_bold = venuename_tex
{txt}
{com}. replace  venuename_tex_bold = "\textbf{c -(}"+venuename_tex+"{c )-}" if current
{txt}variable {bf}{res}venuename_tex_bold{sf}{txt} was {bf}{res}str34{sf}{txt} now {bf}{res}str40{sf}
{txt}(133 real changes made)

{com}. replace  venuename_tex_bold = "\emph{c -(}"+venuename_tex+"{c )-}" if year>2024
{txt}(14 real changes made)

{com}. replace venuename_tex_bold = "Turner Field\$^\ddagger\$" if venuename_tex=="Turner Field"
{txt}(1 real change made)

{com}. replace venuename_tex_bold = "\emph{c -(}New Athletics Stadium$^\S${c )-}" if venuename_tex=="New Athletics Stadium"
{txt}(1 real change made)

{com}. replace venuename_tex_bold = "\emph{c -(}New Browns Stadium$^\P${c )-}" if venuename_tex=="New Browns Stadium"
{txt}(1 real change made)

{com}. replace venuename_tex_bold = "\emph{c -(}New Fire Stadium$^\|${c )-}" if venuename_tex=="New Fire Stadium"
{txt}(1 real change made)

{com}. 
. replace tcdol="[\\$1,150]" if venuename_tex=="Climate Pledge Arena*"
{txt}variable {bf}{res}tcdol{sf}{txt} was {bf}{res}str7{sf}{txt} now {bf}{res}str9{sf}
{txt}(1 real change made)

{com}. replace tc2024dol="[\\$1,334]" if venuename_tex=="Climate Pledge Arena*"
{txt}variable {bf}{res}tc2024dol{sf}{txt} was {bf}{res}str7{sf}{txt} now {bf}{res}str9{sf}
{txt}(1 real change made)

{com}. replace pcdol="[\\$0]" if venuename_tex=="Climate Pledge Arena*"
{txt}(1 real change made)

{com}. replace pc2024dol="[\\$0]" if venuename_tex=="Climate Pledge Arena*"
{txt}(1 real change made)

{com}. replace pubpct100stpct="[0\%]" if venuename_tex=="Climate Pledge Arena*"
{txt}(1 real change made)

{com}. 
. replace tcdol="TBD" if venuename_tex=="New Fire Stadium"
{txt}(1 real change made)

{com}. 
. g lastyearst  = string(lastyear,"%9.0f")
{txt}
{com}. replace lastyearst="" if lastyear==.
{txt}(138 real changes made)

{com}. replace lastyearst ="[2030]" if venuename_tex=="Empower Field at Mile High" /*Announced tentative replacement date*/
{txt}variable {bf}{res}lastyearst{sf}{txt} was {bf}{res}str4{sf}{txt} now {bf}{res}str6{sf}
{txt}(1 real change made)

{com}. 
. 
. replace tc2024dol="" if year>2024
{txt}(12 real changes made)

{com}. replace pc2024dol="" if year>2024
{txt}(11 real changes made)

{com}. 
. g lifespan2025 = lastyear-year+1
{txt}(138 missing values generated)

{com}. replace lifespan2025 = lastyear-year+1
{txt}(0 real changes made)

{com}. replace lifespan2025 = 2026-year if lifespan2025==.
{txt}(138 real changes made)

{com}. replace lifespan2025 = 2026-year if lastyear>2025 &lastyear!=. /*Keeps age for future closures in 2025 terms*/
{txt}(8 real changes made)

{com}. replace lifespan2025 = . if lifespan2025<1
{txt}(14 real changes made, 14 to missing)

{com}. 
. so year venuename_tex
{txt}
{com}. 
