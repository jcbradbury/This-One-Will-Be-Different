{com}. 
. do "$dofiles\02-fig6.1.do"
{txt}
{com}. /* This file provides the code for mapping Braves franchise historical attendance.
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> 1901-2024 data from Lahman Baseball Database: https://sabr.org/lahman-database/ (Teams.csv file)
> The SABR Lahman Baseball Database 1871-2024, Release Date: Oct 30, 2025
> 
> 2025 attendance data from Baseball-Reference: https://www.baseball-reference.com/teams/ATL/attend.shtml
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\): 6.1
> Tables (Stata viewer): 
> Data (outdat\): attend_atl.dta
> Other: 
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. 
. /*Import the raw Teams.csv file*/
. import delimited "$data\Teams.csv", clear
{res}{txt}(encoding automatically selected: ISO-8859-1)
{text}(48 vars, 3,584 obs)

{com}. 
. g x1915 = 1915
{txt}
{com}. g x1953 = 1953
{txt}
{com}. g x1966 = 1966
{txt}
{com}. g x1997 = 1997
{txt}
{com}. g x2017 = 2017
{txt}
{com}. 
. keep if franchid=="ATL"
{txt}(3,435 observations deleted)

{com}. drop if year<1901
{txt}(25 observations deleted)

{com}. 
. insobs 1
{txt}(1 observation added)

{com}. replace yearid = 2025 if year==.
{txt}(1 real change made)

{com}. 
. replace attendance = 2903167    if yearid==2025
{txt}(1 real change made)

{com}. replace ghome = 81 if yearid ==2025
{txt}(1 real change made)

{com}. replace franchid ="ATL" if year ==2025
{txt}(1 real change made)

{com}. 
. g attg = attendance/ghome
{txt}
{com}. format attg %9.0fc
{txt}
{com}. 
. save "$outdat\attend_atl.dta", replace
{txt}{p 0 4 2}
file {bf}
C:\Users\jcbra\GitHub\This-One-Will-Be-Different\outdat\attend_atl.dta{rm}
saved
{p_end}

{com}. 
. /* Data output into the data\ folder
> save "$data\attend_atl.dta", replace
> export delimited "$data\attend_atl.csv", replace
> */
. 
. /*Fig 6.1*/
. twoway bar attg year if franchid=="ATL" ,  bc(gs10)  ///
> || dropline attg x1915 if franchid=="ATL" ,  lpattern(longdash) mcolor(none) lcolor(black) lw(vthin) ,  ///
> || dropline attg x1953 if franchid=="ATL" ,  lpattern(longdash) mcolor(none) lcolor(black) lw(vthin),  ///
> || dropline attg x1966 if franchid=="ATL" ,  lpattern(longdash) mcolor(none) lcolor(black) lw(vthin), ///
> || dropline attg x1997 if franchid=="ATL" ,  lpattern(longdash) mcolor(none) lcolor(black) lw(vthin),  ///
> || dropline attg x2017 if franchid=="ATL" ,  lpattern(longdash) mcolor(none) lcolor(black) lw(vthin)  ///
> ytitle("Attendance (per game)", axis(1) size(medium))  ///
> text(49000 1915  "Braves" "Field", placement(n) box bc(white) fc(white)) ///
> text(49000 1953  "Milwaukee  " "Stadium  ", placement(n) box bc(white) fc(white)) ///
> text(49000 1966  " Atlanta" " Stadium", placement(n) box bc(white) fc(white)) ///
> text(49000 1997  "Turner" "Field", placement(n) box bc(white) fc(white)) ///
> text(49000 2017  "Truist" "Park", placement(n) box bc(white) fc(white)) ///
> ylabel(,angle(horizontal) axis(1)) ///
> xtitle(Season) ///
> xlabel(1900(10)2020 2025 "   2025") ///
> legend(order(1 "Attendance" 2 "New Stadium")  bmargin(l=20 b=50) pos(9) ring(0) rows(2) size(small) symxsize(10) region(lcolor(black)) ) ///
> plotregion(margin(t=6 b=1 )) ///
> name(atl_attend2025a, replace) scheme(plotplain)
{res}{txt}
{com}. /*
> graph export "$figs\Fig6.1.pdf", as(pdf) replace
> graph export "$tif\Fig6.1.tif", as(tif) width(3000)  replace
> */
. 
{txt}end of do-file

{com}. do "$dofiles\02-fig6.5.do"
{txt}
{com}. 
. /* This file provides the code for tracking the Atlanta Braves annual payroll rank.
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> payroll2025.dta
> 
> Annual payroll rank data culled from annual Baseball-Reference  Miscellaneous Team Info pages. For example, the 2025 can be found here: https://www.baseball-reference.com/leagues/majors/2025-misc.shtml.
> 
> Note about MLB payroll data: 
> There are many other sources for MLB payroll data, which do not all agree. I use the Baseball-Reference collection because the data source is credible, and its payroll calculations are consistently available for the longest period. Other databases may calculate payroll burdens differently, but in general the ranks do not differ considerably. I would describe these data as reasonably accurate, but perhaps not precise. 
> 
> The Baseball-Reference ranking is more favorable to the Atlanta Braves than others.
> Source: 2025 Payroll Rank (Link)
> Baseball-Reference: 6 (https://www.baseball-reference.com/leagues/majors/2025-misc.shtml)
> USA Today:      8 (https://www.usatoday.com/story/sports/mlb/2025/10/13/mlb-teams-payroll-2025-highest-lowest/86667489007/)
> Fangraphs: 10 (https://blogs.fangraphs.com/the-2025-payrolls-and-beyond/)
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\): 6.5
> Tables (Stata viewer): 
> Data (outdat\):
> Other: 
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. 
. use "$data\payroll2025.dta"
{txt}
{com}. 
. /* Data output into the data\ folder
> export delimited "$data\payroll2025.csv"
> */
. 
. /*Figure 6.5*/
. twoway bar mlbrank year if year>2016 ,   connect(stair) ysc(reverse) barw(.75) mlab(mlbrank) mlabpos(6) mlabsize(large) ///
> || bar mlbrank year if year>1996&year<2017,   connect(stair) ysc(reverse) barw(.75) mlab(mlbrank) mlabpos(6) mlabsize(large) /// if year>1999 &year<2024
> || bar mlbrank year if year<1997 ,   connect(stair) ysc(reverse) barw(.75) mlab(mlbrank) mlabpos(6) mlabsize(large) /// if year>1999 &year<2024
> xlabel(1990(5)2020 2025, labsize(vlarge)) legend(off) ///
> ylabel(1 5 10 15 20 25 30, labsize(vlarge)) ///
> ytitle(MLB Team Payroll Rank, size(vlarge))  ///
> xtitle(Season, size(vlarge))  ///
> text(25 2020 "Truist Park", placement(s) box bc(white) fc(white) size(vlarge)) ///
> text(25 2006.5  "Turner Field", placement(s) box bc(white) fc(white) size(vlarge)) ///
> text(25 1992.5  "Atlanta-Fulton" "County Stadium", placement(s) box bc(white) fc(white) size(vlarge)) ///
> xsize(2) ysize(1) ///
> xline(1996.5, lp(dash) lw(medthick) lc(black)) xline(2016.5, lp(dash) lw(medthick) lc(black)) ///
> plotregion(margin(t=1 b=1 l=5 r=5)) ///
> name(payroll25, replace)
{res}{txt}
{com}. 
. /*
> graph export "$figs\Fig6.2.pdf", as(pdf) replace
> graph export "$tif\Fig6.2.tif", as(tif) width(3000)  replace
> */
. 
{txt}end of do-file

