{com}. do "$dofiles\02-fig5.5.do"
{txt}
{com}. /* This file provides the code for forcasting cumulative public funding of sports venues.
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> venue_forecast.dta
> venuesdb_base.dta
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\): 5.5
> Tables (Stata viewer): 
> Data (outdat\): forecast_cost.dta ; cumulative_cost.dta
> Other:  
> CITED in text: Projected venue costs for 2020s and 2030s
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. 
. 
. use "$data\venue_forecast.dta", clear /*Data used for Figure 5.2*/
{txt}
{com}. 
. keep year vensforecast_r
{txt}
{com}. 
. /*Extropolate cost of future venues (see 02-fig5.3_5.4_tab5.1.do for explanation) */
. *Extrapolate replacement cost of 1990s-2000s venues not already replaced using 2020s median, which is $605 million
. g pubforecast605 = vensforecast_r*605 if year>2019&year<2030
{txt}(121 missing values generated)

{com}. 
. *Extrapolate replacement cost of 1990s-2000s venues not already replaced using 42.2% increase from 2020s median for 2030 venues $860 million
. g pubforecast860 =  vensforecast_r*860  if year>2029
{txt}(121 missing values generated)

{com}. 
. drop if year<2020
{txt}(111 observations deleted)

{com}. 
. so year
{txt}
{com}. save "$outdat\forecast_cost.dta", replace
{txt}{p 0 4 2}
file {bf}
C:\Users\jcbra\GitHub\This-One-Will-Be-Different\outdat\forecast_cost.dta{rm}
saved
{p_end}

{com}. 
. /* Data output into the data\ folder
> save "$data\forecast_cost.dta", replace
> export delimited "$data\forecast_cost.csv", replace
> */
. 
. use "$data\venuesdb_base.dta", clear
{txt}
{com}. 
. collapse (sum) publiccost publiccost2024 totalcost totalcost2024 , by(year)
{res}{txt}
{com}. 
. so year
{txt}
{com}. tsset year
{res}
{p 0 15 2}{txt:Time variable: }{res:year}{txt:, }{res:{bind:1909}}{txt: to }{res:{bind:2032}}{txt:, but with gaps}{p_end}
{txt}{col 9}Delta: {res}1 unit
{txt}
{com}. 
. /*Sum up public costs until that year. Convert to billions*/
. g cumpc2024 = sum(publiccost2024) if year<=year
{txt}
{com}. g cumpc2024bil = cumpc2024/1000
{txt}
{com}. 
. format cumpc2024 %9.0fc
{txt}
{com}. format cumpc2024bil %9.0fc
{txt}
{com}. 
. so year
{txt}
{com}. 
. /*Merge observed costs with forecasted costs*/
. merge 1:1 year using "$data\forecast_cost.dta"
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}              92
{txt}{col 9}from master{col 30}{res}              82{txt}  (_merge==1)
{col 9}from using{col 30}{res}              10{txt}  (_merge==2)

{col 5}Matched{col 30}{res}              10{txt}  (_merge==3)
{col 5}{hline 41}

{com}. so year
{txt}
{com}. drop _m
{txt}
{com}. 
. /*Create variable that combines public costs and forecasted costs by year*/
. g combinedpub = publiccost2024 if year<2020
{txt}(20 missing values generated)

{com}. replace combinedpub = publiccost2024 + pubforecast605 if combinedpub ==. &year>2019 &year<2030
{txt}(7 real changes made)

{com}. replace combinedpub = pubforecast605 if combinedpub ==. &year>2019 &year<2030
{txt}(3 real changes made)

{com}. 
. replace combinedpub = publiccost2024 + pubforecast860 if combinedpub ==. &year>2029&year<2040 
{txt}(3 real changes made)

{com}. replace combinedpub = pubforecast860 if combinedpub ==. & year>2029
{txt}(7 real changes made)

{com}. 
. /*Generate cumulative costs with forecasted venues*/
. g forecast_cumpc2024 = sum(combinedpub) if year<=year
{txt}
{com}. g forecast_cumpc2024bil = forecast_cumpc2024/1000
{txt}
{com}. 
. /*This fills out the planned spending through 2039, rather than stopping*/
. replace cumpc2024bil =cumpc2024bil[_n-1] if year>2032
{txt}(7 real changes made)

{com}.         
. format forecast_cumpc2024 %9.0fc
{txt}
{com}. format forecast_cumpc2024bil %9.0fc
{txt}
{com}. 
. save "$outdat\cumulative_cost.dta", replace
