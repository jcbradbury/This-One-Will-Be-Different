{com}. 
. do "$dofiles\02-fig3.1.do"
{txt}
{com}. /*This file provides the code for tracking historical US major league sports venue construction. 
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> venuesdb_base.dta
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\): 3.1
> Tables (Stata viewer): 
> Data (outdat\):
> Other: 
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. 
. use "$data\venuesdb_base.dta", clear
{txt}
{com}. 
. so year
{txt}
{com}. by year: egen scount= sum(stadium)
{txt}
{com}. by year: egen acount= sum(arena)
{txt}
{com}. g vens= acount +scount
{txt}
{com}. 
. collapse scount acount vens, by(year)
{res}{txt}
{com}. 
. tsset year
{res}
{p 0 15 2}{txt:Time variable: }{res:year}{txt:, }{res:{bind:1909}}{txt: to }{res:{bind:2032}}{txt:, but with gaps}{p_end}
{txt}{col 9}Delta: {res}1 unit
{txt}
{com}. tsfill
{txt}
{com}. tssmooth ma ma11vens = vens, window(5 1 5)
{txt}The smoother applied was
{res}{p 5 5 5}(1/11)*[x(t-5) + x(t-4) + x(t-3) + x(t-2) + x(t-1) + 1*x(t) + x(t+1) + x(t+2) + x(t+3) + x(t+4) + ...; x(t)= vens{p_end}
{txt}Note: Missing values are given a weight of zero in the smoother.

{com}. 
. save "$outdat\venue_count.dta", replace
{txt}{p 0 4 2}
file {bf}
C:\Users\jcbra\GitHub\This-One-Will-Be-Different\outdat\venue_count.dta{rm}
saved
{p_end}

{com}. 
. /* Data output into the data\ folder
> save "$data\venue_count.dta", replace
> export delimited "$data\venue_count.csv", replace
> */
. 
. /*Figure 3.1*/
. twoway bar vens year if year<2020,  bc(gs5)  ///
> || rbar vens scount year if year<2020, bc(gs10) /// ||
> ||line ma11vens year if year<2020, lp(solid) lc(black) lw(medium) ///
> ytitle("Sports Venues Opened", size(medlarge)) ///
> xtitle(,size(medlarge)) ///
> xlabel(1910(10)2020,labsize(medium)) ///
> ylabel(0(2)12, angle(horizontal) labsize(medium))  ///
> legend(order(2 "Arenas" 1 "Stadiums" 3 "Trend") ring(0) pos(11) cols(1) size(medium) symxsize(7)) ///
> xline(1960, lp(dash)) xline(1990, lp(dash)) xline(2020, lp(dash)) ///
> text(6 1935 "Inaugural" "Era", box bcolor(white) size(medlarge) ) ///
> text(8 1975 "Superstadium" "Era", box bcolor(white) size(medlarge)) ///
> text(11.25 2007 "Stadium" "Mania", box bcolor(white) size(medlarge)) ///
> name(counts_3eras, replace) scheme(plotplain)
{res}{txt}
{com}. /*
> graph export "$figs\Fig3.1.pdf", as(pdf) replace
> graph export "$tif\Fig3.1.tif", as(tif) width(3000)  replace
> */
. 
{txt}end of do-file

{com}. do "$dofiles\02-fig5.1.do"
{txt}
{com}. /* This file provides the code for measuring the hosting lifespans of sports venues over time.
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> venuesdb_base.dta
> 
> Intermediate Output (working directory):
> 
> Final Output:
> Figures(figs\): 5.1
> Tables (Stata viewer): 
> Data (outdat\): lifespan_collapse.dta
> Other: 
> */
. 
. *************************
. **** SETUP **************
. *************************
. /*Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> */
. 
. use "$data\venuesdb_base.dta", clear
{txt}
{com}. 
. /*Lifespan of current venues in 2025*/
. g lifespan2025 = lastyear-year+1
{txt}(112 missing values generated)

{com}. replace lifespan2025 = lastyear-year+1
{txt}(0 real changes made)

{com}. replace lifespan2025 = 2026-year if lifespan2025==.
{txt}(112 real changes made)

{com}. replace lifespan2025 = 2026-year if lastyear>2025 &lastyear!=. /*Keeps age for future closures in 2025 terms*/
{txt}(8 real changes made)

{com}. replace lifespan2025 = . if lifespan2025<1
{txt}(11 real changes made, 11 to missing)

{com}. 
. /*Lifespan of venues in 2029 that are not scheduled to close*/
. g lifespan2029 = lastyear-year+1
{txt}(112 missing values generated)

{com}. replace lifespan2029 = lastyear-year+1
{txt}(0 real changes made)

{com}. replace lifespan2029 = 2030-year if lifespan2029==.
{txt}(112 real changes made)

{com}. replace lifespan2029 = . if lifespan2029<1
{txt}(5 real changes made, 5 to missing)

{com}. 
. g renovationspan_2025 = 2025-lastrenovation+1
{txt}(185 missing values generated)

{com}. g renovationspan_2029 = 2029-lastrenovation+1
{txt}(185 missing values generated)

{com}. replace renovationspan_2029 = 2029-lastrenovation+1
{txt}(0 real changes made)

{com}. replace renovationspan_2029 = 2029-future_renovation_complete+1 if future_renovation_complete!=.
{txt}(13 real changes made)

{com}. */
. 
. so decade
{txt}
{com}. by decade: egen medlifesp = median(lifespan2029)
{txt}(5 missing values generated)

{com}. by decade: egen low25lifesp = pctile(lifespan2029), p(25)
{txt}(5 missing values generated)

{com}. by decade: egen hi75lifesp = pctile(lifespan2029), p(75)
{txt}(5 missing values generated)

{com}. by decade: egen low5lifesp = pctile(lifespan2029), p(5)
{txt}(5 missing values generated)

{com}. by decade: egen hi95lifesp = pctile(lifespan2029), p(95)
{txt}(5 missing values generated)

{com}. by decade: egen minlifesp = min(lifespan2029)
{txt}(5 missing values generated)

{com}. by decade: egen maxlifesp = max(lifespan2029)
{txt}(5 missing values generated)

{com}. 
. sum lifespan2029 if decade<2000, detail

                        {txt}lifespan2029
{hline 61}
      Percentiles      Smallest
 1%    {res}       10              6
{txt} 5%    {res}       19             10
{txt}10%    {res}       23             12       {txt}Obs         {res}        161
{txt}25%    {res}       31             12       {txt}Sum of wgt. {res}        161

{txt}50%    {res}       35                      {txt}Mean          {res}  39.9441
                        {txt}Largest       Std. dev.     {res} 17.99835
{txt}75%    {res}       48             88
{txt}90%    {res}       62            106       {txt}Variance      {res} 323.9406
{txt}95%    {res}       72            116       {txt}Skewness      {res} 1.615222
{txt}99%    {res}      116            118       {txt}Kurtosis      {res} 7.067055
{txt}
{com}. 
. collapse  medlifesp low25lifesp hi75lifesp low5lifesp hi95lifesp minlifesp maxlifesp, by(decade)
{res}{txt}
{com}. 
. g x35 = 35
{txt}
{com}. 
. save "$outdat\lifespan_collapse.dta", replace
{txt}{p 0 4 2}
file {bf}
C:\Users\jcbra\GitHub\This-One-Will-Be-Different\outdat\lifespan_collapse.dta{rm}
saved
{p_end}

{com}. 
. /* Data output into the data\ folder
> save "$data\lifespan_collapse.dta", replace
> export delimited "$data\lifespan_collapse.csv", replace
> */
. 
. /*Figure 5.1 */
. twoway rcap minlifesp maxlifesp decade if decade<2000, lc(black) lw(thin) ///
> || rbar low25lifesp hi75lifesp decade if decade<2000, fcolor(gs6) lcolor(gs6) barw(3) ///
> || rcap medlifesp medlifesp decade if decade<2000, lc(white) msize(4) ///
> || connect medlifesp decade if decade<2000, lc(black) lp(vshortdash) ms(o) mc(black) lw(thin) /// || line x35 decade if decade<2000, lc(black) lp(vshortdash) ///
> || line x35 decade if decade==1950, lc(gs7) lp(dash) /// || scatter lifespan2029 decade if decade<2000, ms(oh) mc(black) ///
> ylabel(0(10)120, gmin gmax angle(horizonta) labsize(medium)) ///
> xlabel(1900 "1900s" 1910 "1910s" 1920 "1920s" 1930 "1930s" 1940 "1940s" 1950 "1950s" 1960 "1960s" 1970 "1970s" 1980 "1980s" 1990 "1990s", labsize(medium) ) /// 
> yline(35, lp(dash) )  ///
> legend(order(4 "Decade Median" 2 "Decade Middle 50%"  1 "Decade Range (Min to Max)" 5 "Sample Median = 35" ) ring(0) pos(1) cols(1) symxsize(8) size(medium)) ///
> xtitle(Decade Opened, size(medium)) ///
> ytitle(Years Hosting Major League Team, size(medlarge)) ///
> text(84 1952 "(Hosting status through 2029)", placement(e)) ///
> name(ls_minmax, replace) 
{res}{txt}
{com}. /*
> graph export "$figs\Fig5.1.pdf", as(pdf) replace
> graph export "$tif\Fig5.1.tif", as(tif) width(3000)  replace
> */
. 
{txt}end of do-file

