{txt}
{com}. /* This file provides the code for generating median venue funding.
> 
> **********************************************************************
> ** Title: This One Will Be Different: False Promises and Fiscal Realities of Publicly Funded Stadiums
> ** Author: Bradbury, J.C.
> ** Publisher: Oxford University Press
> ** Year: 2026
> ********************************************************************** 
> 
> Data Input (data\): 
> venuesdb_base.dta
> 
> Intermediate Output (working directory):
> ven_median_collapse_temp.dta
> ven_median_collapse_arena_temp.dta
> ven_median_collapse_stadium_temp.dta
> 
> Final Output:
> Figures(figs\): 5.3, 5.4 
> Tables (Stata viewer): 5.1 
> Data (outdat\): ven_median_collapse.dta
> Other: 
> */
. 
. /**************Run code below first if have not set up home directory
> 
> global path ="[PATH]" // <== Replace [PATH] with home directory
> cd "$path" // Set your working directory
> 
> do "00-setup.do"
> 
> *************/
. 
. use "$data\venuesdb_base.dta", clear
{txt}
{com}. 
. /*Aggregate venue construction totals and costs by decade*/
. collapse  (sum) stadium arena (median) pubpct100 totalcost2024 publiccost2024 , by(decade)
{res}{txt}
{com}. 
. so decade
{txt}
{com}. save ven_median_collapse_temp, replace
{txt}{p 0 4 2}
file {bf}
ven_median_collapse_temp.dta{rm}
saved
{p_end}

{com}. 
. /*Separate out arenas*/
. use "$data\venuesdb_base.dta", clear
{txt}
{com}. collapse  (sum) arena (median) pubpct100 totalcost2024 publiccost2024 if arena, by(decade)
{res}{txt}
{com}. rename pubpct100 pubpct100a 
{res}{txt}
{com}. rename  totalcost2024 totalcost2024a
{res}{txt}
{com}. rename publiccost2024 publiccost2024a
{res}{txt}
{com}. 
. so decade
{txt}
{com}. save ven_median_collapse_arena_temp, replace
{txt}{p 0 4 2}
file {bf}
ven_median_collapse_arena_temp.dta{rm}
saved
{p_end}

{com}. 
. /*Separte out stadiums*/
. use  "$data\venuesdb_base.dta", clear
{txt}
{com}. collapse  (sum) stadium (median) pubpct100 totalcost2024 publiccost2024 if stadium, by(decade)
{res}{txt}
{com}. 
. rename pubpct100 pubpct100s 
{res}{txt}
{com}. rename  totalcost2024 totalcost2024s
{res}{txt}
{com}. rename publiccost2024 publiccost2024s
{res}{txt}
{com}. 
. so decade
{txt}
{com}. save ven_median_collapse_stadium_temp, replace
{txt}{p 0 4 2}
file {bf}
ven_median_collapse_stadium_temp.dta{rm}
saved
{p_end}

{com}. 
. /*Merge files for all venues, arenas, stadiums*/
. use ven_median_collapse_temp, clear
{txt}
{com}. so decade
{txt}
{com}. 
. merge 1:1 decade using ven_median_collapse_arena_temp
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
{txt}{col 5}Matched{col 30}{res}              14{txt}  (_merge==3)
{col 5}{hline 41}

{com}. drop _m
{txt}
{com}. 
. so decade
{txt}
{com}. merge 1:1 decade using ven_median_collapse_stadium_temp
{res}
