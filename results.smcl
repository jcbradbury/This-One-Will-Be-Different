. /*Step 2a: Aggregate venue openings by type and year */
. so year
{txt}
{com}. by year: egen scount= sum(stadium)
{txt}
{com}. by year: egen acount= sum(arena)
{txt}
{com}. g vens= acount +scount
{txt}
{com}. 
. collapse scount acount vens, by(year)
{res}{txt}
{com}. 
. g future=0
{txt}
{com}. replace future=1 if year>2024
{txt}(7 real changes made)

{com}. 
. tsset year
{res}
{p 0 15 2}{txt:Time variable: }{res:year}{txt:, }{res:{bind:1909}}{txt: to }{res:{bind:2032}}{txt:, but with gaps}{p_end}
{txt}{col 9}Delta: {res}1 unit
{txt}
{com}. set obs `=_N+1'
{txt}{p}
Number of observations ({bf:_N}) was 92,
now 93.
{p_end}

{com}. replace year = 2039 in 93
{txt}(1 real change made)

{com}. tsfill
{txt}
{com}. 
